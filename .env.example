# 1. Primary Firebase Service Layer (Authentication & Cloud Firestore)
# Note: If left empty, PCMS operates securely in enterprise simulated mode with zero crash.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Decoupled Object Storage Layer (Cloudflare R2 / Google Drive API / Simulated)
# Modes: "simulated" (zero-config, high-speed local base64/blob) | "cloudflare-r2" | "google-drive"
VITE_STORAGE_PROVIDER=simulated
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_DOMAIN=

# 3. Default Master Telegram Bot (Can also be dynamically registered in Admin Dashboard)
VITE_DEFAULT_TELEGRAM_BOT_TOKEN=
VITE_DEFAULT_TELEGRAM_CHAT_ID=

# 4. App Runtime Parameters
VITE_APP_NAME="PCMS Enterprise"
VITE_SESSION_TIMEOUT_MINUTES=30
